# =============================================================================
# config.env.example — template di configurazione per backup.sh
#
# Copia questo file in config.env e personalizzalo. config.env contiene
# credenziali/path reali: non condividerlo, non versionarlo pubblicamente.
#   cp config.env.example config.env
# =============================================================================

# ─── elenco destinazioni attive, nell'ordine in cui verranno eseguite ───────
# Ogni ID qui dentro deve avere un blocco DEST_<id>_... corrispondente più
# sotto. Puoi avere quante destinazioni vuoi, anche più di una dello stesso
# tipo (es. due dischi locali, due host SSH diversi).
DESTINATIONS=(esempio_ssh esempio_usb esempio_syncfolder esempio_cloud)

# ── esempio_ssh — un host remoto raggiungibile via SSH (es. un NAS o un server) ─────────
DEST_esempio_ssh_TYPE="ssh"
DEST_esempio_ssh_NAME="Server remoto"
DEST_esempio_ssh_HOST="user@remote-host.example"
DEST_esempio_ssh_KEY="$HOME/.ssh/id_ed25519_backup"
DEST_esempio_ssh_BASE_PATH="/path/to/backup/destination"
DEST_esempio_ssh_KEEP=4                     # quanti snapshot storici mantenere

# ── esempio_usb — un'unità rimovibile che dev'essere montata ────────────────
DEST_esempio_usb_TYPE="local"
DEST_esempio_usb_NAME="Chiavetta USB"
DEST_esempio_usb_PATH="/media/user/BACKUP_DRIVE"
DEST_esempio_usb_KEEP_DAYS=60
DEST_esempio_usb_REQUIRE_MOUNT=true         # errore se non è collegata/montata

# ── esempio_syncfolder — una cartella locale già sincronizzata al cloud da
#    un client esterno (es. Dropbox, Google Drive desktop, Nextcloud...).
#    Lo script si limita a scrivere lì dentro; ci pensa il client a caricarla.
DEST_esempio_syncfolder_TYPE="local"
DEST_esempio_syncfolder_NAME="Cartella sincronizzata (cloud)"
DEST_esempio_syncfolder_PATH="$HOME/sync-client/backup"
DEST_esempio_syncfolder_KEEP_DAYS=30
DEST_esempio_syncfolder_REQUIRE_MOUNT=false # è una cartella normale, non un mount

# ── esempio_cloud — cloud vero via rclone (Drive, S3, Backblaze, ecc.) ──────
# Richiede `rclone config` già eseguito per creare il remote.
DEST_esempio_cloud_TYPE="rclone"
DEST_esempio_cloud_NAME="Cloud (rclone)"
DEST_esempio_cloud_REMOTE="remote-name:backup-folder"

# ─── notifiche (es. bot Telegram — adatta send_notification() per altro canale) ─
ENABLE_NOTIFICATIONS=false
NOTIFY_BOT_TOKEN=""
NOTIFY_CHAT_ID=""

# ─── log ──────────────────────────────────────────────────────────────────────
# Prefisso delle cartelle di backup nelle destinazioni di tipo "local"
# (backup_YYYY-MM-DD_HH-MM). La retention cancella solo cartelle con questo prefisso.
BACKUP_PREFIX="backup"

# Attenzione: se il backup gira come servizio root, $HOME e' la home di root
# a meno che install.sh non l'abbia impostata. Per i percorsi usa path assoluti
# o $HOME, ma verifica sempre con il test dell'installer.
LOG_FILE="$SCRIPT_DIR/backup.log"

# ─── discovery progetti ────────────────────────────────────────────────────────
# Se il WorkingDirectory di una unit systemd finisce con uno di questi nomi,
# lo script risale alla cartella padre — utile quando un progetto ha
# backend/frontend (o simili) come sottocartelle separate.
PROMOTE_TO_PARENT=(backend api src)

# Sottostringhe di path da escludere sempre dalla discovery automatica.
EXCLUDE_PROJECT_PATHS=()   # es. (nome-servizio-da-ignorare)

# ─── percorsi "documenti" ────────────────────────────────────────────────────
# File o CARTELLE che vuoi sempre nel backup ma che non hanno una loro unit
# systemd — non solo config tecniche: anche documenti, note, materiali di
# lavoro. Lista manuale, la aggiorni solo quando aggiungi qualcosa di nuovo.
DOCUMENT_PATHS=(
  "/home/user/esempio-documento.pdf"
  "/home/user/esempio-cartella-documenti"
)

# ─── dump database (opzionale) ───────────────────────────────────────────────
# Richiede mysqldump e un file di credenziali [client]\nuser=...\npassword=...
# (mai credenziali dentro questo file).
ENABLE_DB_DUMP=false
DB_NAMES=(example_db)
DB_CREDENTIALS_FILE="$HOME/.my-backup.cnf"

# ─── esclusioni per rsync (destinazioni tipo ssh) ────────────────────────────
RSYNC_EXCLUDES=(--exclude '__pycache__' --exclude '.git' --exclude 'venv'
                --exclude '.venv' --exclude 'node_modules' --exclude '*.pyc')

# ─── esclusioni per zip (destinazioni tipo local) ────────────────────────────
ZIP_EXCLUDES=(-x "*/__pycache__/*" -x "*/.git/*" -x "*/venv/*" -x "*/.venv/*"
              -x "*/node_modules/*" -x "*.pyc")

# ─── esclusioni per rclone (destinazioni tipo rclone) ────────────────────────
RCLONE_EXCLUDES=(--exclude "__pycache__/**" --exclude ".git/**" --exclude "venv/**"
                  --exclude ".venv/**" --exclude "node_modules/**")
